{
  "name": "qualicart",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node packages/checkout/src/server.ts",
    "test": "node --test \"packages/checkout/test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"packages/checkout/test/**/*.test.ts\"",
    "test:coverage:lcov": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bdd": "cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
