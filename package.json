{
  "name": "qualicart",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --import ./packages/checkout/src/instrumentation.ts packages/checkout/src/server.ts",
    "start:catalog": "node --import ./packages/catalog/src/instrumentation.ts packages/catalog/src/server.ts",
    "start:checkout": "node --import ./packages/checkout/src/instrumentation.ts packages/checkout/src/server.ts",
    "test": "node --test \"packages/*/test/unit/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"packages/*/test/unit/**/*.test.ts\"",
    "test:contract": "node --test \"packages/*/test/contract/**/*.ts\"",
    "test:integration": "node --test \"packages/checkout/test/integration/**/*.ts\"",
    "test:property": "node --test \"packages/checkout/test/property/**/*.ts\"",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:browser": "playwright test --ui",
    "test:mutation": "stryker run",
    "slo:load": "k6 run load/checkout-slo.js",
    "audit": "npm audit --audit-level=high",
    "test:ai": "node --test \"packages/ai-assistant/test/**/*.test.ts\"",
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml",
    "ai:chat": "node packages/ai-assistant/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bdd": "cucumber-js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cucumber/cucumber": "^11.2.0",
    "@eslint/js": "^9.20.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@pact-foundation/pact": "^17.0.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.8.0",
    "promptfoo": "^0.121.17",
    "testcontainers": "^12.0.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
