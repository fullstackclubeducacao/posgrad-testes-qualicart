{
  "consumer": {
    "name": "qualicart-checkout"
  },
  "interactions": [
    {
      "description": "uma busca por um produto existente (CAM-001)",
      "request": {
        "method": "GET",
        "path": "/produtos/CAM-001"
      },
      "response": {
        "body": {
          "nome": "Camiseta",
          "preco": 59.9,
          "sku": "CAM-001"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.nome": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.preco": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "uma busca por um produto inexistente (INEXISTENTE-000)",
      "request": {
        "method": "GET",
        "path": "/produtos/INEXISTENTE-000"
      },
      "response": {
        "body": {
          "erro": "Produto INEXISTENTE-000 nao encontrado"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.erro": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "qualicart-catalog"
  }
}