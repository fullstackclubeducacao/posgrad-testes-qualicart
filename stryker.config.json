{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "packages/checkout/src/coupon.ts",
    "packages/checkout/src/cart.ts",
    "packages/checkout/src/shipping.ts"
  ],
  "reporters": ["clear-text", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "concurrency": 4
}
